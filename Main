import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("--- DANH GIA XEP HANG TO CHUC ---");
        Employee[] employees = new Employee[2];
        for (int i = 0; i < employees.length; i++) {
            System.out.println("\n--- NHAP NHAN VIEN " + (i + 1) + " ---");
            System.out.print("Nhap ten nhan vien: ");
            String name = sc.nextLine();
            System.out.print("Nhap diem KPI (0-100): ");
            int kpi = sc.nextInt();
            sc.nextLine();
            employees[i] = new Employee(name, kpi);
        }
        Branch[] branches = new Branch[2];
        for (int i = 0; i < branches.length; i++) {
            System.out.println("\n--- NHAP CHI NHANH " + (i + 1) + " ---");
            System.out.print("Nhap ten chi nhanh: ");
            String name = sc.nextLine();
            System.out.print("Nhap doanh thu (ty dong): ");
            double revenue = sc.nextDouble();
            sc.nextLine();
            branches[i] = new Branch(name, revenue);
        }
        IAppraisable[] targets = {employees[0], employees[1], branches[0], branches[1]};
        System.out.println();
        System.out.println("+-------------------------------------------------------+");
        System.out.println("|          BAO CAO XEP HANG CHAT LUONG RIKKEI          |");
        System.out.println("+-------------------------------------------------------+");
        System.out.println("| NHAN VIEN:");
        for (Employee employee : employees) {
            System.out.printf("| [Nhan vien] %-25s | Xep hang: %-12s |%n", employee.getEmpName(), employee.getRating());
        }
        System.out.println("| CHI NHANH:");
        for (Branch branch : branches) {
            System.out.printf("| [Chi nhanh] %-24s | Xep hang: %-12s |%n", branch.getBranchName(), branch.getRating());
        }
        System.out.println("\n--- DANH GIA THONG QUA INTERFACE IAppraisable ---");
        for (IAppraisable target : targets) {
            System.out.println("Xep hang: " + target.getRating());
        }
    }
}
